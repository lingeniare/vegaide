{
	"name": "vega-authentication",
	"displayName": "%displayName%",
	"description": "%description%",
	"publisher": "vscode",
	"license": "MIT",
	"version": "0.0.1",
	"engines": {
		"vscode": "^1.99.0"
	},
	"categories": [
		"Other"
	],
	"api": "none",
	"enabledApiProposals": [
		"authIssuers"
	],
	"extensionKind": [
		"ui",
		"workspace"
	],
	"activationEvents": [],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"authentication": [
			{
				"label": "%authProviderLabel%",
				"id": "vega",
				"authorizationServerGlobs": [
					"https://api.vega.chat"
				]
			}
		],
		"mcpServerDefinitionProviders": [
			{
				"id": "context7",
				"label": "Context7"
			}
		]
	},
	"main": "./out/extension.js",
	"browser": "./dist/browser/extension.js",
	"scripts": {
		"compile": "gulp compile-extension:vega-authentication",
		"compile-web": "node esbuild.browser.mts",
		"watch": "gulp watch-extension:vega-authentication",
		"watch-web": "node esbuild.browser.mts --watch",
		"vscode:prepublish": "npm run compile"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/microsoft/vscode.git"
	}
}
